          "queryType": "stats",
          "editorMode": "code",
          "maxLines": 1000
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "noValue": "0"
