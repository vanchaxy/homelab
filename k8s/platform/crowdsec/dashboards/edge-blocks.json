{
  "title": "Edge blocks — VPS firewall",
  "uid": "vps-edge-blocks",
  "tags": [
    "crowdsec",
    "vyos",
    "firewall",
    "security"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "schemaVersion": 41,
  "templating": {
    "list": [
      {
        "name": "ds_vl",
        "label": "Logs",
        "type": "datasource",
        "query": "victoriametrics-logs-datasource",
        "current": {},
        "hide": 2
      },
      {
        "name": "reason",
        "label": "Reason",
        "type": "custom",
        "query": "GeoIP,CrowdSec",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Blocked connections",
      "description": "Packets dropped by the VPS GeoIP and CrowdSec rules in the selected range (each logged drop is one packet, usually a SYN or a single UDP datagram).",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "${ds_vl}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "${ds_vl}"
          },
          "expr": "hostname:vps-router app_name:kernel \"[ipv4-\" | extract \"[ipv4-<hook>-<chain>-<rule>-<act>]\" | extract \"SRC=<src> \" | extract \"DST=<dst> \" | extract \"PROTO=<proto> \" | extract \"DPT=<dpt> \" | format if (rule:in(4, 24)) \"GeoIP\" as reason | format if (rule:in(5, 25)) \"CrowdSec\" as reason | format if (rule:in(24, 25)) \"VPS SSH\" as target | format if (rule:in(4, 5)) \"public IP\" as target | filter reason:~\"^(${reason})$\" | stats count() blocked",
          "queryType": "stats",
          "editorMode": "code",
          "maxLines": 1000
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "GeoIP blocks",
      "description": "Dropped by the Russia/China GeoIP rules (forward 4, input 24).",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "${ds_vl}"
