      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "${ds_vl}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "${ds_vl}"
          },
          "expr": "hostname:vps-router app_name:kernel \"[ipv4-\" | extract \"[ipv4-<hook>-<chain>-<rule>-<act>]\" | extract \"SRC=<src> \" | extract \"DST=<dst> \" | extract \"PROTO=<proto> \" | extract \"DPT=<dpt> \" | format if (rule:in(4, 24)) \"GeoIP\" as reason | format if (rule:in(5, 25)) \"CrowdSec\" as reason | format if (rule:in(24, 25)) \"VPS SSH\" as target | format if (rule:in(4, 5)) \"public IP\" as target | filter reason:~\"^(${reason})$\" | stats by (src, reason) count() packets, count_uniq(dpt) ports, max(_time) last_seen | sort by (packets desc) | limit 50",
          "queryType": "instant",
          "editorMode": "code",
          "maxLines": 1000
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json",
            "replace": false,
            "keepTime": false
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "packets",
                "destinationType": "number"
              },
              {
                "targetField": "ports",
                "destinationType": "number"
              },
              {
                "targetField": "last_seen",
                "destinationType": "time"
              }
            ],
            "fields": {}
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Line": true,
              "id": true,
              "labels": true,
              "streams": true,
              "streamId": true,
              "tsNs": true,
              "level": true,
              "detected_level": true
            },
            "indexByName": {
              "src": 0,
              "reason": 1,
              "packets": 2,
              "ports": 3,
              "last_seen": 4
            },
            "renameByName": {
              "src": "Source IP",
              "reason": "Reason",
              "packets": "Packets",
              "ports": "Distinct ports",
              "last_seen": "Last seen"
            },
            "includeByName": {}
