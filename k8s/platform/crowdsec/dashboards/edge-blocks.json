        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "${ds_vl}"
          },
          "expr": "hostname:vps-router app_name:kernel \"[ipv4-\" | extract \"[ipv4-<hook>-<chain>-<rule>-<act>]\" | extract \"SRC=<src> \" | extract \"DST=<dst> \" | extract \"PROTO=<proto> \" | extract \"DPT=<dpt> \" | format if (rule:in(4, 24)) \"GeoIP\" as reason | format if (rule:in(5, 25)) \"CrowdSec\" as reason | format if (rule:in(24, 25)) \"VPS SSH\" as target | format if (rule:in(4, 5)) \"public IP\" as target | filter reason:~\"^(${reason})$\" | stats by (reason) count() blocked",
          "queryType": "statsRange",
          "editorMode": "code",
          "maxLines": 1000,
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 85,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "GeoIP"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CrowdSec"
            },
            "properties": [
