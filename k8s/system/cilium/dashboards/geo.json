    {
      "type": "geomap",
      "title": "Who is reaching your public IP",
      "description": "Marker size = number of connections/packets from that location. Hover for city, country and distinct IPs.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 16,
        "h": 14
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "${ds_vl}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "${ds_vl}"
          },
          "expr": "kubernetes.container_name:cilium-agent flow.verdict:DROPPED geo.src.country:* | stats by (geo.src.lat, geo.src.lon, geo.src.city, geo.src.country_name) count() n, count_uniq(flow.IP.source) ips | rename geo.src.lat as lat, geo.src.lon as lon, geo.src.city as city, geo.src.country_name as country",
          "queryType": "instant",
          "editorMode": "code",
          "maxLines": 1000
        },
        {
          "refId": "B",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "${ds_vl}"
          },
          "expr": "kubernetes.container_name:cilium-agent flow.event_type.type:4 geo.src.country:* | stats by (geo.src.lat, geo.src.lon, geo.src.city, geo.src.country_name) count() n, count_uniq(flow.IP.source) ips | rename geo.src.lat as lat, geo.src.lon as lon, geo.src.city as city, geo.src.country_name as country",
          "queryType": "instant",
          "editorMode": "code",
          "maxLines": 1000
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json",
            "replace": false,
            "keepTime": false
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "lat",
                "destinationType": "number"
              },
              {
                "targetField": "lon",
                "destinationType": "number"
              },
              {
                "targetField": "n",
                "destinationType": "number"
              }
            ],
            "fields": {}
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Line": true,
              "id": true,
              "labels": true,
              "streams": true,
              "streamId": true,
              "tsNs": true,
              "level": true,
              "detected_level": true
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": []
      },
      "options": {
        "view": {
          "id": "coords",
          "lat": 25,
          "lon": 10,
          "zoom": 1.25,
          "allLayers": false
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true,
          "showAttribution": true
        },
        "basemap": {
          "type": "carto",
          "name": "Basemap",
          "config": {
            "theme": "auto",
            "showLabels": true
          }
        },
        "layers": [
          {
            "type": "markers",
            "name": "dropped probes",
            "tooltip": true,
            "filterData": {
              "id": "byRefId",
              "options": "A"
            },
            "location": {
              "mode": "coords",
              "latitude": "lat",
              "longitude": "lon"
            },
            "config": {
              "showLegend": true,
              "style": {
                "color": {
                  "fixed": "red"
                },
                "opacity": 0.55,
                "size": {
                  "field": "n",
                  "fixed": 5,
                  "min": 4,
                  "max": 28
                },
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/circle.svg"
                },
                "text": {
                  "mode": "fixed",
                  "fixed": ""
                }
              }
            }
          },
          {
            "type": "markers",
            "name": "accepted connections",
            "tooltip": true,
            "filterData": {
              "id": "byRefId",
              "options": "B"
            },
            "location": {
              "mode": "coords",
              "latitude": "lat",
              "longitude": "lon"
            },
            "config": {
              "showLegend": true,
              "style": {
                "color": {
                  "fixed": "green"
                },
                "opacity": 0.55,
                "size": {
                  "field": "n",
                  "fixed": 5,
                  "min": 4,
                  "max": 28
                },
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/circle.svg"
                },
                "text": {
                  "mode": "fixed",
                  "fixed": ""
                }
              }
            }
          }
        ],
        "tooltip": {
          "mode": "details"
        }
      },
      "id": 6
    },
