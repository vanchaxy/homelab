      "transparent": true,
      "options": {
        "mode": "markdown",
        "content": "### 🌍 Who reaches the cluster from the internet, and where the cluster reaches out to\nPublic IPs only (LAN, tailnet and cluster addresses are never geolocated). IP geolocation by [DB-IP.com](https://db-ip.com) (CC BY 4.0)"
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "External sources",
      "description": "Distinct public IPs that connected or were dropped.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "${ds_vl}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "${ds_vl}"
          },
          "expr": "kubernetes.container_name:cilium-agent (flow.event_type.type:4 or flow.verdict:DROPPED) geo.src.country:* | stats count_uniq(flow.IP.source) n",
          "queryType": "stats",
          "editorMode": "code",
          "maxLines": 1000
