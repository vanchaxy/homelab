    {
      "type": "table",
      "title": "🔭 External visitors",
      "description": "Every public IP that reached or probed the cluster in the range, with location and network.",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 11
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "${ds_vl}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "${ds_vl}"
          },
          "expr": "kubernetes.container_name:cilium-agent (flow.event_type.type:4 or flow.verdict:DROPPED) geo.src.country:* | format \"<flow.l4.TCP.destination_port><flow.l4.UDP.destination_port>\" as port | format \"<flow.destination.namespace>/<flow.destination.pod_name>\" as svc | replace_regexp (\"-[a-z0-9]{6,10}-[a-z0-9]{5}$\", \"\") at svc | stats by (flow.IP.source, geo.src.country, geo.src.country_name, geo.src.city, geo.src.asn_org) count() if (flow.event_type.type:4) accepted, count() if (flow.verdict:DROPPED) dropped, count_uniq(port) ports, count_uniq(svc) if (flow.event_type.type:4) services, max(_time) last_seen | sort by (last_seen desc) | limit 500",
          "queryType": "instant",
          "editorMode": "code",
          "maxLines": 1000
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "json",
            "replace": false,
            "keepTime": false
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "accepted",
                "destinationType": "number"
              },
              {
                "targetField": "dropped",
                "destinationType": "number"
              },
              {
                "targetField": "ports",
                "destinationType": "number"
              },
              {
                "targetField": "services",
                "destinationType": "number"
              },
              {
                "targetField": "last_seen",
                "destinationType": "time"
              }
            ],
            "fields": {}
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Line": true,
              "id": true,
              "labels": true,
              "streams": true,
              "streamId": true,
              "tsNs": true,
              "level": true,
              "detected_level": true
            },
            "indexByName": {
              "flow.IP.source": 0,
              "geo.src.country": 1,
              "geo.src.country_name": 2,
              "geo.src.city": 3,
              "geo.src.asn_org": 4,
              "accepted": 5,
              "dropped": 6,
              "ports": 7,
              "services": 8,
              "last_seen": 9
            },
            "renameByName": {
              "flow.IP.source": "IP",
              "geo.src.country": "CC",
              "geo.src.country_name": "Country",
              "geo.src.city": "City",
              "geo.src.asn_org": "Network",
              "accepted": "Accepted",
              "dropped": "Dropped",
              "ports": "Ports tried",
              "services": "Services reached",
              "last_seen": "Last seen"
            },
            "includeByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "CC"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 55
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Accepted"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Dropped"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Ports tried"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Services reached"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Last seen"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              },
              {
                "id": "custom.width",
                "value": 130
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Last seen",
            "desc": true
          }
        ]
      },
      "id": 9
    },
