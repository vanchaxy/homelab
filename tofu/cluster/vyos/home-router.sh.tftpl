set service dhcp-server shared-network-name WORK subnet 10.10.30.0/24 lease '86400'
set service dhcp-server shared-network-name WORK subnet 10.10.30.0/24 option default-router '10.10.30.1'
set service dhcp-server shared-network-name WORK subnet 10.10.30.0/24 option name-server '10.10.30.1'
set service dhcp-server shared-network-name WORK subnet 10.10.30.0/24 range 0 start '10.10.30.100'
set service dhcp-server shared-network-name WORK subnet 10.10.30.0/24 range 0 stop '10.10.30.199'
