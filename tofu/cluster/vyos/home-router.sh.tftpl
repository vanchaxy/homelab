set service dhcp-server shared-network-name MGMT subnet 10.10.10.0/24 option name-server '10.10.10.1'
set service dhcp-server shared-network-name MGMT subnet 10.10.10.0/24 range 0 start '10.10.10.100'
set service dhcp-server shared-network-name MGMT subnet 10.10.10.0/24 range 0 stop '10.10.10.199'
set service dhcp-server shared-network-name MGMT subnet 10.10.10.0/24 subnet-id '10'
