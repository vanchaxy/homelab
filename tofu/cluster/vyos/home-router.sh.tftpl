set service https api graphql authentication type 'key'
set service https api keys id vymanager key "$(cat /config/auth/https-api-key.vymanager)"
set service https api rest
set service https listen-address '10.10.10.1'
set service mdns repeater allow-service '_googlecast._tcp'
set service mdns repeater allow-service '_googlezone._tcp'
set service mdns repeater allow-service '_airplay._tcp'
set service mdns repeater allow-service '_raop._tcp'
set service mdns repeater allow-service '_nvstream._tcp'
set service mdns repeater interface 'br20'
set service mdns repeater interface 'eth1.50'
set service mdns repeater interface 'eth1.40'
set service mdns repeater interface 'eth1.70'
set service ntp allow-client address '127.0.0.0/8'
set service ntp allow-client address '169.254.0.0/16'
set service ntp allow-client address '10.0.0.0/8'
set service ntp allow-client address '172.16.0.0/12'
set service ntp allow-client address '192.168.0.0/16'
set service ntp allow-client address '::1/128'
set service ntp allow-client address 'fe80::/10'
set service ntp allow-client address 'fc00::/7'
set service ntp server time1.vyos.net
set service ntp server time2.vyos.net
set service ntp server time3.vyos.net
set service ssh port '22'
set system config-management commit-confirm action 'reload'
set system config-management commit-revisions '100'
set system console device ttyS0 speed '115200'
set system host-name 'vyos'
set system login user vyos authentication encrypted-password "$(cat /config/auth/login-hash.vyos)"
set system login user vyos authentication plaintext-password ''
set system login user vyos authentication public-keys wsl key '${laptop_public_ed25519_key}'
set system login user vyos authentication public-keys wsl type 'ssh-ed25519'
set system name-server '10.10.10.1'
set system option reboot-on-upgrade-failure '5'
set system syslog local facility all level 'info'
set system syslog local facility local7 level 'debug'
set system syslog remote 10.10.61.214 facility kern level 'warning'
set system syslog remote 10.10.61.214 facility local5 level 'info'
set system syslog remote 10.10.61.214 port '514'
set system syslog remote 10.10.61.214 protocol 'udp'
