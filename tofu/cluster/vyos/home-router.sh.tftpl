# Home router (VyOS): the complete desired config as set commands, applied by tofu
# (tofu/cluster/vyos/apply.sh). Secrets live in /config/auth on the router and are
# read with $(cat ...) at apply time. AdGuard config: /config/containers/adguard/conf,
# mdns-log script: /config/containers/mdns-log/run.sh (copy in vyos/mdns-log.sh).

set container name adguard allow-host-networks
set container name adguard description 'AdGuard Home DNS'
set container name adguard image 'docker.io/adguard/adguardhome:v0.107.79'
set container name adguard restart 'always'
set container name adguard volume conf destination '/opt/adguardhome/conf'
set container name adguard volume conf source '/config/containers/adguard/conf'
set container name adguard volume work destination '/opt/adguardhome/work'
set container name adguard volume work source '/config/containers/adguard/work'
set container name mdns-log allow-host-networks
set container name mdns-log capability 'net-admin'
set container name mdns-log capability 'net-raw'
set container name mdns-log command '/bin/sh /run.sh'
set container name mdns-log description 'mDNS query/announce logger'
set container name mdns-log image 'docker.io/library/alpine:3.20'
set container name mdns-log restart 'always'
set container name mdns-log volume devlog destination '/dev/log'
set container name mdns-log volume devlog source '/run/systemd/journal/dev-log'
set container name mdns-log volume script destination '/run.sh'
set container name mdns-log volume script source '/config/containers/mdns-log/run.sh'
set container name tailscale allow-host-networks
set container name tailscale capability 'net-admin'
set container name tailscale capability 'net-raw'
set container name tailscale description 'Tailscale'
set container name tailscale device tun destination '/dev/net/tun'
set container name tailscale device tun source '/dev/net/tun'
set container name tailscale environment TS_AUTH_ONCE value 'true'
set container name tailscale environment TS_AUTHKEY value 'file:/run/ts-authkey'
set container name tailscale environment TS_EXTRA_ARGS value '--snat-subnet-routes=false --accept-routes=false --advertise-exit-node'
set container name tailscale environment TS_HOSTNAME value 'home-router'
set container name tailscale environment TS_ROUTES value '10.10.0.0/16'
set container name tailscale environment TS_STATE_DIR value '/var/lib/tailscale'
set container name tailscale environment TS_USERSPACE value 'false'
set container name tailscale image 'docker.io/tailscale/tailscale:stable'
set container name tailscale restart 'always'
set container name tailscale volume authkey destination '/run/ts-authkey'
set container name tailscale volume authkey source '/config/auth/tailscale-authkey'
set container name tailscale volume state destination '/var/lib/tailscale'
set container name tailscale volume state source '/config/containers/tailscale'
set container name vymanager-backend environment BETTER_AUTH_SECRET value "$(cat /config/auth/vymanager-backend.BETTER_AUTH_SECRET)"
set container name vymanager-backend environment DATABASE_URL value "$(cat /config/auth/vymanager-backend.DATABASE_URL)"
set container name vymanager-backend environment FRONTEND_INTERNAL_URL value 'http://172.31.255.4:3000'
set container name vymanager-backend environment FRONTEND_URL value 'http://10.10.10.1:3000'
set container name vymanager-backend environment NODE_ENV value 'production'
set container name vymanager-backend environment SSH_ENCRYPTION_KEY value "$(cat /config/auth/vymanager-backend.SSH_ENCRYPTION_KEY)"
set container name vymanager-backend environment TRUSTED_ORIGINS value 'http://10.10.10.1:3000'
set container name vymanager-backend environment VYMANAGER_APPLIANCE_API_KEY value "$(cat /config/auth/vymanager-backend.VYMANAGER_APPLIANCE_API_KEY)"
set container name vymanager-backend environment VYMANAGER_APPLIANCE_HOST value '10.10.10.1'
set container name vymanager-backend environment VYMANAGER_APPLIANCE_PORT value '443'
set container name vymanager-backend environment VYMANAGER_APPLIANCE_PROTOCOL value 'https'
set container name vymanager-backend environment VYMANAGER_APPLIANCE_VERSION value '1.5'
set container name vymanager-backend environment VYMANAGER_MODE value 'appliance'
set container name vymanager-backend image 'ghcr.io/community-vyprojects/vymanager-backend:beta'
set container name vymanager-backend network vymanager address '172.31.255.3'
set container name vymanager-backend network vymanager mac '02:8d:44:d1:45:1c'
set container name vymanager-backend restart 'always'
set container name vymanager-frontend environment BACKEND_URL value 'http://172.31.255.3:8000'
set container name vymanager-frontend environment BETTER_AUTH_SECRET value "$(cat /config/auth/vymanager-frontend.BETTER_AUTH_SECRET)"
set container name vymanager-frontend environment BETTER_AUTH_URL value 'http://10.10.10.1:3000'
set container name vymanager-frontend environment DATABASE_URL value "$(cat /config/auth/vymanager-frontend.DATABASE_URL)"
set container name vymanager-frontend environment NEXT_PUBLIC_APP_URL value 'http://10.10.10.1:3000'
set container name vymanager-frontend environment NODE_ENV value 'production'
set container name vymanager-frontend environment PUBLIC_WS_URL value 'ws://10.10.10.1:8000'
set container name vymanager-frontend environment TRUSTED_ORIGINS value 'http://10.10.10.1:3000'
set container name vymanager-frontend image 'ghcr.io/community-vyprojects/vymanager-frontend:beta'
set container name vymanager-frontend network vymanager address '172.31.255.4'
set container name vymanager-frontend network vymanager mac '02:95:3e:df:e5:b3'
set container name vymanager-frontend restart 'always'
set container name vymanager-postgres environment POSTGRES_DB value 'vymanager'
set container name vymanager-postgres environment POSTGRES_PASSWORD value "$(cat /config/auth/vymanager-postgres.POSTGRES_PASSWORD)"
set container name vymanager-postgres environment POSTGRES_USER value 'vymanager'
set container name vymanager-postgres image 'postgres:16-alpine'
set container name vymanager-postgres network vymanager address '172.31.255.2'
set container name vymanager-postgres network vymanager mac '02:eb:92:e9:81:23'
set container name vymanager-postgres restart 'always'
set container name vymanager-postgres volume pgdata destination '/var/lib/postgresql/data'
set container name vymanager-postgres volume pgdata source '/config/containers/vymanager-postgres'
set container network vymanager description 'VyManager'
set container network vymanager prefix '172.31.255.0/24'
