# VPS (VyOS): the complete desired config as set commands, applied by tofu
# (tofu/cluster/vyos/apply.sh). Secrets live in /config/auth on the VPS and are
# read with $(cat ...) at apply time.

set container name tailscale allow-host-networks
set container name tailscale capability 'net-admin'
set container name tailscale capability 'net-raw'
set container name tailscale description 'Tailscale'
set container name tailscale device tun destination '/dev/net/tun'
set container name tailscale device tun source '/dev/net/tun'
set container name tailscale environment TS_AUTH_ONCE value 'true'
set container name tailscale environment TS_AUTHKEY value 'file:/run/ts-authkey'
set container name tailscale environment TS_EXTRA_ARGS value '--accept-routes=false'
set container name tailscale environment TS_HOSTNAME value 'vps-router'
set container name tailscale environment TS_STATE_DIR value '/var/lib/tailscale'
set container name tailscale environment TS_TAILSCALED_EXTRA_ARGS value '--port=41641'
set container name tailscale environment TS_USERSPACE value 'false'
set container name tailscale image 'docker.io/tailscale/tailscale:stable'
set container name tailscale restart 'always'
set container name tailscale volume authkey destination '/run/ts-authkey'
set container name tailscale volume authkey source '/config/auth/tailscale-authkey'
set container name tailscale volume state destination '/var/lib/tailscale'
set container name tailscale volume state source '/config/containers/tailscale'
set firewall global-options state-policy established action 'accept'
set firewall global-options state-policy related action 'accept'
set firewall ipv4 forward filter default-action 'drop'
set firewall ipv4 forward filter rule 11 action 'accept'
set firewall ipv4 forward filter rule 11 destination address '46.38.230.69'
set firewall ipv4 forward filter rule 11 inbound-interface name 'eth0'
set firewall ipv4 forward filter rule 11 outbound-interface name 'wg0'
set firewall ipv4 forward filter rule 21 action 'accept'
set firewall ipv4 forward filter rule 21 inbound-interface name 'wg0'
set firewall ipv4 forward filter rule 21 outbound-interface name 'eth0'
set firewall ipv4 forward filter rule 21 source address '46.38.230.69'
set firewall ipv4 input filter default-action 'drop'
set firewall ipv4 input filter rule 10 action 'accept'
set firewall ipv4 input filter rule 10 inbound-interface name 'lo'
set firewall ipv4 input filter rule 20 action 'accept'
set firewall ipv4 input filter rule 20 protocol 'icmp'
set firewall ipv4 input filter rule 30 action 'accept'
set firewall ipv4 input filter rule 30 description 'SSH, key-only'
set firewall ipv4 input filter rule 30 destination port '47823'
set firewall ipv4 input filter rule 30 protocol 'tcp'
set firewall ipv4 input filter rule 40 action 'accept'
set firewall ipv4 input filter rule 40 description 'Tailscale'
set firewall ipv4 input filter rule 40 destination port '41641'
set firewall ipv4 input filter rule 40 protocol 'udp'
set firewall ipv4 input filter rule 41 action 'accept'
set firewall ipv4 input filter rule 41 description 'Tailscale peer relay'
set firewall ipv4 input filter rule 41 destination port '40000'
set firewall ipv4 input filter rule 41 protocol 'udp'
set firewall ipv4 input filter rule 45 action 'accept'
set firewall ipv4 input filter rule 45 description 'WireGuard from home-router'
set firewall ipv4 input filter rule 45 destination port '51820'
set firewall ipv4 input filter rule 45 protocol 'udp'
set interfaces ethernet eth0 address 'dhcp'
set interfaces ethernet eth0 description 'WAN'
set interfaces ethernet eth0 ip
set interfaces loopback lo description 'managed by tofu (tofu/cluster/vyos)'
set interfaces wireguard wg0 address '10.255.254.1/30'
set interfaces wireguard wg0 description 'public address to home-router'
set interfaces wireguard wg0 ip adjust-mss '1380'
set interfaces wireguard wg0 mtu '1420'
set interfaces wireguard wg0 peer home-router allowed-ips '10.255.254.2/32'
set interfaces wireguard wg0 peer home-router allowed-ips '46.38.230.69/32'
set interfaces wireguard wg0 peer home-router public-key '${home_router_wg_public_key}'
set interfaces wireguard wg0 port '51820'
set interfaces wireguard wg0 private-key "$(cat /config/auth/wg-pub.priv)"
set protocols static route 46.38.230.69/32 interface wg0
set service ntp allow-client address '127.0.0.0/8'
set service ntp allow-client address '169.254.0.0/16'
set service ntp allow-client address '10.0.0.0/8'
set service ntp allow-client address '172.16.0.0/12'
set service ntp allow-client address '192.168.0.0/16'
set service ntp allow-client address '::1/128'
set service ntp allow-client address 'fe80::/10'
set service ntp allow-client address 'fc00::/7'
set service ntp server time1.vyos.net
set service ntp server time2.vyos.net
set service ntp server time3.vyos.net
set service ssh disable-password-authentication
set service ssh port '47823'
set system config-management commit-revisions '100'
set system console device ttyS0 speed '115200'
set system host-name 'vyos'
set system login user vyos authentication encrypted-password "$(cat /config/auth/login-hash.vyos)"
set system login user vyos authentication plaintext-password ''
set system login user vyos authentication public-keys laptop key '${laptop_public_ed25519_key}'
set system login user vyos authentication public-keys ci key '${ci_public_ed25519_key}'
set system login user vyos authentication public-keys ci type 'ssh-ed25519'
set system login user vyos authentication public-keys laptop type 'ssh-ed25519'
set system name-server 'eth0'
set system option reboot-on-upgrade-failure '5'
set system syslog local facility all level 'info'
set system syslog local facility local7 level 'debug'
