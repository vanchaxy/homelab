machine:
  kubelet:
    image: ghcr.io/siderolabs/kubelet:${kubernetes_version}
    defaultRuntimeSeccompProfileEnabled: true
    disableManifestsDirectory: true
%{ if ssd_disk_id != "" ~}
    extraMounts:
      - destination: /var/mnt/storage
        type: bind
        source: /var/mnt/storage
        options:
          - bind
          - rshared
          - rw
  disks:
    - device: /dev/disk/by-id/${ssd_disk_id}
      partitions:
        - mountpoint: /var/mnt/storage
%{ endif ~}
---
apiVersion: v1alpha1
kind: KubeletConfig
$patch: delete
---
apiVersion: v1alpha1
kind: UnattendedInstallConfig
installer:
  image: ${install_image}
provisioning:
  diskSelector:
    match: '"/dev/disk/by-id/${install_disk_id}" in disk.symlinks'
  wipe: true
---
apiVersion: v1alpha1
kind: HostnameConfig
auto: "off"
hostname: ${hostname}
---
apiVersion: v1alpha1
kind: ResolverConfig
nameservers:
  - address: 10.10.60.1
---
apiVersion: v1alpha1
kind: KmsgLogConfig
name: vector-syslog
url: udp://10.10.61.243:6050/
---
apiVersion: v1alpha1
kind: SysctlConfig
params:
  net.core.default_qdisc: fq
  net.ipv4.tcp_congestion_control: bbr
  kernel.kexec_load_disabled: "1"
---
apiVersion: v1alpha1
kind: CRICustomizationConfig
name: spegel
content: |
  [plugins."io.containerd.cri.v1.images"]
    discard_unpacked_layers = false
---
apiVersion: v1alpha1
kind: SecurityProfileConfig
$patch: delete
---
apiVersion: v1alpha1
kind: VolumeConfig
name: EPHEMERAL
$patch: delete
---
apiVersion: v1alpha1
kind: KubeNodeConfig
labels:
  topology.kubernetes.io/region: ${cluster_name}
  topology.kubernetes.io/zone: ${node_name}
%{ if ssd_disk_id != "" ~}
  node.longhorn.io/create-default-disk: 'config'
%{ endif ~}
%{ if ssd_disk_id != "" ~}
annotations:
  node.longhorn.io/default-disks-config: '${
    jsonencode(
      [{name="nmve", path="/var/mnt/storage", allowScheduling=true, tags=["ssd"]}])
  }'
%{ endif ~}
