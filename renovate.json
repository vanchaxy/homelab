{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track versions pinned in raw manifests and workflows via a `# renovate:` comment (e.g. Grafana CR .spec.version, CI tool versions)",
      "managerFilePatterns": [
        "/^k8s/.+\\.ya?ml$/",
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+\\S+:\\s*[\"']?(?<currentValue>[^\"'@\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?[\"']?"
      ]
    },
    {
      "customType": "regex",
      "description": "Track versions pinned in OpenTofu locals via a `# renovate:` comment (VyOS Stream, Talos, Kubernetes, Cilium bootstrap)",
      "managerFilePatterns": [
        "/^tofu/.+\\.tf$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+\\S+\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "customDatasources": {
    "vyos-stream": {
      "description": "VyOS Stream releases, read from the official download page",
      "defaultRegistryUrlTemplate": "https://vyos.net/get/stream/",
      "format": "html"
    }
  },
  "packageRules": [
    {
      "description": "Do not pin digests for dependencies tracked through version-only custom fields",
      "matchPackageNames": [
        "alpine/helm",
        "grafana/grafana"
      ],
      "pinDigests": false
    },
    {
      "description": "Skip private GHCR images that Renovate cannot read",
      "matchPackageNames": [
        "ghcr.io/vanchaxy/bank-sync",
        "ghcr.io/vanchaxy/hermes-karyna",
        "ghcr.io/vanchaxy/toloka-indexer"
      ],
      "enabled": false
    },
    {
      "description": "VyOS Stream: versions are YYYY.MM, taken from the ISO links on the download page",
      "matchDatasources": [
        "custom.vyos-stream"
      ],
      "extractVersion": "^https://community-downloads\\.vyos\\.dev/stream/(?<version>\\d{4}\\.\\d{2})/",
      "versioning": "regex:^(?<major>\\d{4})\\.(?<minor>\\d{2})$"
    },
    {
      "description": "Digest-only refreshes of floating or already-pinned tags carry no version change: batch them into one PR",
      "matchUpdateTypes": [
        "digest"
      ],
      "groupName": "image digests"
    },
    {
      "description": "GitHub Actions only run CI, and the PR's own checks exercise them: one PR for all of them",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    },
    {
      "description": "OpenTofu providers share one lock file per root module: bump them together",
      "matchManagers": [
        "terraform"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "tofu providers"
    },
    {
      "description": "Talos and Kubernetes must be upgraded one minor version at a time: a PR per minor, not grouped (a group collapses them into a single jump)",
      "matchFileNames": [
        "tofu/**",
        ".github/workflows/k8s.yaml"
      ],
      "matchPackageNames": [
        "siderolabs/talos",
        "kubernetes/kubernetes"
      ],
      "separateMultipleMinor": true
    },
    {
      "description": "Cilium: the k8s Helm release and the tofu bootstrap version",
      "matchPackageNames": [
        "cilium",
        "cilium/cilium"
      ],
      "groupName": "cilium"
    },
    {
      "description": "Argo CD: Helm chart and the image tag it is pinned to",
      "matchPackageNames": [
        "argo-cd",
        "quay.io/argoproj/argocd"
      ],
      "groupName": "argocd"
    },
    {
      "description": "external-dns: both releases of the chart and the AdGuard webhook provider",
      "matchPackageNames": [
        "external-dns",
        "ghcr.io/muhlba91/external-dns-provider-adguard"
      ],
      "groupName": "external-dns"
    },
    {
      "description": "VictoriaMetrics stack",
      "matchPackageNames": [
        "victoria-metrics-k8s-stack"
      ],
      "groupName": "telemetry"
    },
    {
      "description": "VolSync and the snapshot controller it relies on",
      "matchPackageNames": [
        "volsync",
        "snapshot-controller"
      ],
      "groupName": "volsync"
    },
    {
      "description": "Backrest and its VolSync operator (chart and image)",
      "matchPackageNames": [
        "garethgeorge/backrest",
        "/backrest-volsync-operator/"
      ],
      "groupName": "backrest"
    },
    {
      "description": "Immich server, machine learning and chart must run the same release",
      "matchPackageNames": [
        "immich",
        "ghcr.io/immich-app/**"
      ],
      "groupName": "immich"
    },
    {
      "description": "Kaneo API and web are released together",
      "matchPackageNames": [
        "ghcr.io/usekaneo/**"
      ],
      "groupName": "kaneo"
    },
    {
      "description": "Paperless-ngx with its Gotenberg and Tika sidecars",
      "matchPackageNames": [
        "ghcr.io/paperless-ngx/paperless-ngx",
        "docker.io/gotenberg/gotenberg",
        "docker.io/apache/tika"
      ],
      "groupName": "paperless-ngx"
    },
    {
      "description": "Patch, digest and pin updates merge themselves once the release has soaked and CI (render + schema check) is green",
      "matchUpdateTypes": [
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "minimumReleaseAge": "3 days",
      "automerge": true
    },
    {
      "description": "Minor updates of apps, games and platform services merge themselves after a longer soak",
      "matchFileNames": [
        "k8s/apps/**",
        "k8s/games/**",
        "k8s/platform/**"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "minimumReleaseAge": "7 days",
      "automerge": true
    },
    {
      "description": "Cluster-wide system charts: patches soak a week before merging",
      "matchFileNames": [
        "k8s/system/**"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "CI actions and tools are exercised by the PR's own checks",
      "matchFileNames": [
        ".github/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Lock file maintenance has no version change",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "automerge": true
    },
    {
      "description": "Never automerge: storage, CNI, the database operator, and Talos/Kubernetes (tofu applies on push)",
      "matchPackageNames": [
        "cilium",
        "cilium/cilium",
        "longhorn",
        "cloudnative-pg",
        "siderolabs/talos",
        "kubernetes/kubernetes"
      ],
      "automerge": false
    },
    {
      "matchFileNames": [
        "tofu/**"
      ],
      "automerge": false
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "prometheus-operator-crds bumps its major on nearly every release and only ships CRDs: always automerge in its own PR",
      "matchPackageNames": [
        "prometheus-operator-crds"
      ],
      "minimumReleaseAge": "3 days",
      "automerge": true
    }
  ],
  "platformAutomerge": false
}
